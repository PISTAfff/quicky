<?xml version="1.0" encoding="utf-8"?>
<!-- Next up, 2 cells tall and up: the task large, its chips, and a Done button. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_card_q_light"
    android:paddingStart="16dp"
    android:paddingTop="13dp"
    android:paddingEnd="19dp"
    android:paddingBottom="15dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/w_logo" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_quicky" android:tint="#FF6D4CFF" android:contentDescription="@null" />
            <TextView android:id="@+id/w_label" style="@style/WgMeta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_weight="1" android:singleLine="true" android:text="Next up" android:textColor="#FF6D4CFF" android:textSize="12.5sp" />
            <TextView android:id="@+id/w_more" style="@style/WgMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:singleLine="true" android:textColor="#FF5E5878" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="6dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:id="@+id/w_task" style="@style/WgTitle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="top" android:maxLines="3" android:text="Write the report" android:textColor="#FF2B2540" android:textSize="21sp" />
            <include layout="@layout/w_mascot" android:layout_width="58dp" android:layout_height="52dp" android:layout_gravity="center_vertical" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:id="@+id/w_row_meta" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="horizontal">
                <TextView android:id="@+id/w_chip1" style="@style/WgMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:background="@drawable/w_chip" android:backgroundTint="#FFEDE9FB" android:includeFontPadding="false" android:paddingStart="7dp" android:paddingTop="3dp" android:paddingEnd="7dp" android:paddingBottom="3dp" android:singleLine="true" android:textColor="#FF5E5878" android:textSize="11.5sp" />
                <TextView android:id="@+id/w_chip2" style="@style/WgMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:background="@drawable/w_chip" android:backgroundTint="#FFEDE9FB" android:includeFontPadding="false" android:paddingStart="7dp" android:paddingTop="3dp" android:paddingEnd="7dp" android:paddingBottom="3dp" android:singleLine="true" android:textColor="#FF5E5878" android:textSize="11.5sp" />
            </LinearLayout>
            <FrameLayout android:id="@+id/w_done_wrap" android:layout_width="wrap_content" android:layout_height="38dp">
                <ImageView android:id="@+id/w_done_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_round" android:tint="#FF6D4CFF" android:contentDescription="@null" />
                <ImageView android:id="@+id/w_done_ring" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/w_ring_pill" android:contentDescription="@null" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="16dp">
                    <ImageView android:id="@+id/w_done" android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_check" android:contentDescription="@null" />
                    <TextView android:id="@+id/w_done_text" style="@style/WgBody" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="Done" android:textColor="#FFFFFFFF" android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
