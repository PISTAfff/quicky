<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_card_light"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Next up" android:textColor="#FF7B61FF" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/w_task" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="#FF2B2540" android:textSize="18sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/w_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FF7A7392" android:textSize="12sp" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/w_done_wrap"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="10dp">
        <ImageView android:id="@+id/w_done_bg" android:tint="#FF6D4CFF" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/w_circle" android:contentDescription="@null" />
        <ImageView android:id="@+id/w_done" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:src="@drawable/ic_check" android:contentDescription="Done" />
    </FrameLayout>
</LinearLayout>
