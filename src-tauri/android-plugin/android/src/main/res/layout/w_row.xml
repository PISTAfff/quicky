<?xml version="1.0" encoding="utf-8"?>
<!-- One row of a list widget: the status dot (the tick), the title and chips (due, steps), and on the
     task lists start/pause and delete. Events have an accent bar instead of the dot. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal">
    <FrameLayout android:id="@+id/w_tick" android:layout_width="38dp" android:layout_height="42dp">
        <ImageView android:id="@+id/w_dot" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/w_dot" android:tint="#FF2B2540" android:contentDescription="@null" />
        <ImageView android:id="@+id/w_dot_half" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center" android:src="@drawable/w_dot_half" android:visibility="gone" android:contentDescription="@null" />
        <ImageView android:id="@+id/w_bar" android:layout_width="5dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/w_round" android:visibility="gone" android:contentDescription="@null" />
    </FrameLayout>
    <LinearLayout android:id="@+id/w_row_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp" android:paddingTop="5dp" android:paddingEnd="2dp" android:paddingBottom="5dp">
        <TextView android:id="@+id/w_row_title" style="@style/WgBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="#FF2B2540" android:textSize="15sp" />
        <LinearLayout android:id="@+id/w_row_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="horizontal">
            <TextView android:id="@+id/w_chip1" style="@style/WgMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:background="@drawable/w_chip" android:backgroundTint="#FFEDE9FB" android:includeFontPadding="false" android:paddingStart="7dp" android:paddingTop="3dp" android:paddingEnd="7dp" android:paddingBottom="3dp" android:singleLine="true" android:textColor="#FF5E5878" android:textSize="11.5sp" />
            <TextView android:id="@+id/w_chip2" style="@style/WgMeta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:background="@drawable/w_chip" android:backgroundTint="#FFEDE9FB" android:includeFontPadding="false" android:paddingStart="7dp" android:paddingTop="3dp" android:paddingEnd="7dp" android:paddingBottom="3dp" android:singleLine="true" android:textColor="#FF5E5878" android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/w_state" android:layout_width="34dp" android:layout_height="40dp" android:paddingStart="8dp" android:paddingTop="10dp" android:paddingEnd="6dp" android:paddingBottom="10dp" android:src="@drawable/ic_play" android:visibility="gone" android:contentDescription="Start" />
    <ImageView android:id="@+id/w_delete" android:layout_width="34dp" android:layout_height="40dp" android:paddingStart="6dp" android:paddingTop="10dp" android:paddingEnd="8dp" android:paddingBottom="10dp" android:src="@drawable/ic_trash" android:visibility="gone" android:contentDescription="Delete" />
</LinearLayout>
