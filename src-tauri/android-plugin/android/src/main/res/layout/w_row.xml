<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/w_tick"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="9dp"
        android:src="@drawable/w_tick"
        android:contentDescription="Done" />
    <LinearLayout
        android:id="@+id/w_row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="6dp"
        android:paddingEnd="4dp">
        <TextView android:id="@+id/w_row_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:textColor="#FF2B2540" android:textSize="15sp" />
        <TextView android:id="@+id/w_row_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="#FF7A7392" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
