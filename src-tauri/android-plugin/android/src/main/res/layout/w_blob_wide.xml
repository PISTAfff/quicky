<?xml version="1.0" encoding="utf-8"?>
<!-- Quicky with a speech balloon (like the desktop one): the next task, or that all is done. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:id="@+id/w_blob_box" android:layout_width="0dp" android:layout_height="66dp" android:layout_weight="2">
            <include layout="@layout/w_mascot" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="5dp" />
            <TextView android:id="@+id/w_badge" style="@style/WgMeta" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_gravity="top|end" android:background="@drawable/w_badge" android:gravity="center" android:includeFontPadding="false" android:minWidth="24dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="3" android:textColor="#FFFFFFFF" android:textSize="12sp" />
        </FrameLayout>
        <LinearLayout
            android:id="@+id/w_balloon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="3"
            android:background="@drawable/w_card_q_light"
            android:orientation="vertical"
            android:paddingStart="11dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">
            <TextView android:id="@+id/w_bal_title" style="@style/WgBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:text="Write the report" android:textColor="#FF2B2540" android:textSize="13.5sp" />
            <TextView android:id="@+id/w_bal_sub" style="@style/WgMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:singleLine="true" android:text="3 to do" android:textColor="#FF5E5878" android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
