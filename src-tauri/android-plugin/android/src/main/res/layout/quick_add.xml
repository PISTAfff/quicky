<?xml version="1.0" encoding="utf-8"?>
<!-- The small "add a task" box over the home screen, in the app's card look: compact, sitting just
     above the keyboard. A tap outside it cancels. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qa_outside"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">
    <LinearLayout
        android:id="@+id/qa_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/w_card_q_light"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="17dp"
        android:paddingBottom="15dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/qa_logo" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_quicky" android:contentDescription="@null" />
            <TextView android:id="@+id/qa_title" style="@style/WTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:text="New task" android:textSize="16sp" />
        </LinearLayout>
        <EditText
            android:id="@+id/qa_text"
            style="@style/WBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:background="@drawable/w_field"
            android:hint="Add a mini task"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="500"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textSize="15sp" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="10dp" android:orientation="horizontal">
            <TextView
                android:id="@+id/qa_cancel"
                style="@style/WBody"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/w_round"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Cancel"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/qa_add"
                style="@style/WBody"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/w_round"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Add"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
