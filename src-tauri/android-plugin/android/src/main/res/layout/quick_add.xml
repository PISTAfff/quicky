<?xml version="1.0" encoding="utf-8"?>
<!-- The small "add a task" box over the home screen, in the app's card look. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingTop="96dp"
    android:paddingEnd="20dp">
    <LinearLayout
        android:id="@+id/qa_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/w_card_q_light"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="21dp"
        android:paddingBottom="19dp">
        <TextView android:id="@+id/qa_title" style="@style/WTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New task" android:textSize="20sp" />
        <EditText
            android:id="@+id/qa_text"
            style="@style/WBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/w_field"
            android:hint="Add a mini task"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="500"
            android:padding="14dp"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/qa_add"
            style="@style/WBody"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:background="@drawable/w_round"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Add"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
