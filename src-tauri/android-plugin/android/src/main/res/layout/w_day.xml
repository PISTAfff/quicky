<?xml version="1.0" encoding="utf-8"?>
<!-- A day's heading in the week widget (the text, or the same drawn in Fredoka). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="6dp"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">
    <TextView android:id="@+id/w_day" style="@style/WgTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FF6D4CFF" android:textSize="14sp" />
    <ImageView android:id="@+id/w_day_img" android:layout_width="wrap_content" android:layout_height="wrap_content" android:adjustViewBounds="true" android:scaleType="fitStart" android:visibility="gone" android:contentDescription="@null" />
</FrameLayout>
