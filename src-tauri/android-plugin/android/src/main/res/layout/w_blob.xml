<?xml version="1.0" encoding="utf-8"?>
<!-- Quicky on the home screen, with how many tasks are open on a badge. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">
    <include layout="@layout/w_mascot" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="6dp" />
    <TextView android:id="@+id/w_badge" style="@style/WgMeta" android:layout_width="wrap_content" android:layout_height="24dp" android:layout_gravity="top|end" android:background="@drawable/w_badge" android:gravity="center" android:includeFontPadding="false" android:minWidth="24dp" android:paddingStart="6dp" android:paddingEnd="6dp" android:text="3" android:textColor="#FFFFFFFF" android:textSize="12sp" />
</FrameLayout>
