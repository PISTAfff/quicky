    android:layout_height="match_parent"
    android:padding="4dp">
    <ImageView android:id="@+id/w_add_bg" android:tint="#FF6D4CFF" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center" android:src="@drawable/w_circle" android:contentDescription="@null" />
    <ImageView android:id="@+id/w_add" android:layout_width="56dp" android:layout_height="56dp" android:layout_gravity="center" android:padding="15dp" android:src="@drawable/ic_add" android:contentDescription="Add a task" />
</FrameLayout>
