<?xml version="1.0" encoding="utf-8"?>
<!-- The app's card: a 2dp edge and a hard shadow down and right (the app tokens: shadow). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:top="3dp">
        <shape android:shape="rectangle"><solid android:color="#FF0C0A12" /><corners android:radius="@dimen/w_radius" /></shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><solid android:color="#FF231F2D" /><stroke android:width="2dp" android:color="#FF4C4562" /><corners android:radius="@dimen/w_radius" /></shape>
    </item>
</layer-list>
